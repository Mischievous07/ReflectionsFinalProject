<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Reflections.Views.EntryDetailPage"
    Title="Entry Details">


    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="20">


            <Label
                Text="{Binding Title}"
                FontSize="32"
                FontAttributes="Bold"/>


            <Label
                Text="{Binding Date}"
                TextColor="Gray"
                FontSize="16"/>


            <Border
                Padding="10"
                Stroke="{AppThemeBinding Light=Black, Dark=White}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10">

                <Label
                    Text="{Binding Mood}"
                    FontSize="18"/>

            </Border>


            <Label
                Text="{Binding Content}"
                FontSize="18"/>


            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="10">


                <Button
                    Grid.Column="0"
                    Text="Edit"
                    Clicked="Edit_Clicked"/>


                <Button
                    Grid.Column="1"
                    Text="Delete"
                    Clicked="Delete_Clicked"/>


            </Grid>


        </VerticalStackLayout>


    </ScrollView>


</ContentPage>