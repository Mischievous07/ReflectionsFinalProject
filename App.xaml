<?xml version="1.0" encoding="UTF-8" ?>

<Application
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Reflections.App">


    <Application.Resources>


        <ResourceDictionary>


            <Style
                TargetType="Button">

                <Setter
                    Property="CornerRadius"
                    Value="12"/>

                <Setter
                    Property="FontSize"
                    Value="16"/>

            </Style>



            <Style
                TargetType="Entry">

                <Setter
                    Property="FontSize"
                    Value="16"/>

            </Style>



            <Style
                TargetType="Editor">

                <Setter
                    Property="FontSize"
                    Value="16"/>

            </Style>


        </ResourceDictionary>


    </Application.Resources>


</Application>